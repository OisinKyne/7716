.venv/
__pycache__/
*.pyc
# raw Xatu Parquet + the ingest's derived tables: ~5 GB, rebuilt by run_all.sh
data/
# per-validator intermediates: tens of MB, rebuilt from data/ in seconds.
# results*/*.{md,json,csv,txt} and figures/ are the deliverables and are tracked.
# The glob must cover every per-event results dir (results/, results_besu/,
# results_nethermind/, ...), not just the first one.
results/*.parquet
results_*/*.parquet
